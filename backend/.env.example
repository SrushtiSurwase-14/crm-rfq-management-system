PORT=5000
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRES_IN=8h

# Database - defaults to SQLite file (zero setup, works out of the box).
# To use PostgreSQL instead, set DB_DIALECT=postgres and fill in the vars below.
DB_DIALECT=sqlite
DB_STORAGE=./data/database.sqlite

# PostgreSQL settings (only used when DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_rfq
DB_USER=postgres
DB_PASSWORD=postgres
